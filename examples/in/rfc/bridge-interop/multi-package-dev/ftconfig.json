{
  "compiler": {
    "exportStructFields": true
  },
  "server": {
    "embedded": true,
    "port": "6321"
  },
  "bridge": {
    "enabled": true,
    "hostMode": true,
    "binary": "node",
    "args": ["scripts/host.mjs"]
  },
  "dev": {
    "watch": true,
    "hotReload": true,
    "watchGenerate": true,
    "profile": "auto"
  },
  "output": {
    "typescript": {
      "enabled": true,
      "outputDir": "generated",
      "clientDir": "client"
    }
  }
}
