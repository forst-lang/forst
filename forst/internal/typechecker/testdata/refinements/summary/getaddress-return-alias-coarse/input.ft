package main

type User = {
	name: String
	age: Int
	address: Address
}

type Address = {
	street: String
	country: String
}

is (user User) Adult {
	ensure user.age is Min(18)
}

func acceptAdult(user User) {}

func getAddress(user User): Address {
	return user.address
}

func check(user User) {
	ensure user is Adult()
	addr := getAddress(user)
	addr.country = "XX"
	acceptAdult(user)
}

func main() {}
