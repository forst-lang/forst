package main

type User = {
    name: String
    age: Int
    role: String
    address: Address
}

type Address = {
    street: String
    country: *String
}

is (user User) Adult {
    ensure user.age is Min(18)
}

func acceptAdult(user User) {}

func rename(user User, name String) {
    user.name = name
}

func check(user User) {
    ensure user is Adult()
    rename(user, "Alice")
    acceptAdult(user)
}

func main() {}
