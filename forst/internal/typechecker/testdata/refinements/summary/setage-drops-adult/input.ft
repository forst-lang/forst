package main

type User = {
    name: String
    age: Int
    role: String
    address: Address
}

type Address = {
    street: String
    country: *String
}

is (user User) Adult {
    ensure user.age is Min(18)
}

func acceptAdult(user User) {}

func setAge(user User, age Int) {
    user.age = age
}

func check(user User) {
    ensure user is Adult()
    setAge(user, 12)
    acceptAdult(user)
}

func main() {}
