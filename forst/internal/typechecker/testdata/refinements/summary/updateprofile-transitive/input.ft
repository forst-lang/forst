package main

type User = {
    name: String
    age: Int
    role: String
    address: Address
}

type Address = {
    street: String
    country: *String
}

is (user User) Adult {
    ensure user.age is Min(18)
}

func acceptAdult(user User) {}

type ProfileInput = { name: String }

func updateName(user User, name String) {
    user.name = name
}

func updateProfile(user User, input ProfileInput) {
    updateName(user, input.name)
}

func check(user User, input ProfileInput) {
    ensure user is Adult()
    updateProfile(user, input)
    acceptAdult(user)
}

func main() {}
