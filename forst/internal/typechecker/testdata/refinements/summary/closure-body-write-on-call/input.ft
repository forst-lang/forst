package main

type User = {
    name: String
    age: Int
    role: String
    address: Address
}

type Address = {
    street: String
    country: *String
}

is (user User) Adult {
    ensure user.age is Min(18)
}

func acceptAdult(user User) {}

func check(user User, inputAge Int) {
    ensure user is Adult()
    set := func() {
        user.age = inputAge
    }
    set()
    acceptAdult(user)
}

func main() {}
