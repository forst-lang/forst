package main

type User = {
    name: String
    age: Int
    role: String
    address: Address
}

type Address = {
    street: String
    country: *String
}

is (user User) Adult {
    ensure user.age is Min(18)
}

func acceptAdult(user User) {}

func bumpAge(user User, n Int) {
    if n > 0 {
        user.age = n
        bumpAge(user, n)
    }
}

func check(user User) {
    ensure user is Adult()
    bumpAge(user, 1)
    acceptAdult(user)
}

func main() {}
