package main

type User = {
	name: String
}

type AppContext = {
	session: *String
	user: *User
}

is (ctx AppContext) LoggedIn {
	ensure ctx.session is Present()
	ensure ctx.user is Present()
}

func useSession(s *String) {}
func useUser(u *User) {}

func check(ctx AppContext) {
	ensure ctx is LoggedIn()
	useSession(ctx.session)
	useUser(ctx.user)
}

func main() {}
