package main

type User = {
    name: String
    age: Int
    role: String
    address: Address
}

type Address = {
    street: String
    country: *String
}

is (user User) Adult {
    ensure user.age is Min(18)
}

func acceptAdult(user User) {}

func check(user User) {
    channel := make(chan User)
    ensure user is Adult()
    channel <- user
    acceptAdult(user)
}

func main() {}
