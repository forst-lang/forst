package main

type User = {
    name: String
    age: Int
    role: String
    address: Address
}

type Address = {
    street: String
    country: *String
}

is (user User) Adult {
    ensure user.age is Min(18)
}

func acceptAdult(user User) {}

func unknownRegister(fn func()) {}

func check(user User) {
    ensure user is Adult()
    callback := func() {
        user.age = 12
    }
    unknownRegister(callback)
    acceptAdult(user)
}

func main() {}
