{
  "name": "@forst/errors",
  "version": "0.2.1",
  "description": "Shared tagged error classes for Forst generated clients (invoke transport, harness, unknown failure).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js",
      "require": "./dist/effect.js",
      "default": "./dist/effect.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run sync-jsr-version && bun run build",
    "sync-jsr-version": "node ./scripts/sync-jsr-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "bun test",
    "pack:dry": "npm pack --dry-run --ignore-scripts"
  },
  "keywords": [
    "forst",
    "errors",
    "tagged-error"
  ],
  "author": "haveyaseen",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "effect": ">=3.17.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.4",
    "effect": "^3.17.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forst-lang/forst.git",
    "directory": "packages/errors"
  },
  "homepage": "https://github.com/forst-lang/forst/tree/main/packages/errors#readme",
  "bugs": {
    "url": "https://github.com/forst-lang/forst/issues"
  }
}
