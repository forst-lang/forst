{
  "name": "@forst/runtime",
  "version": "0.5.1",
  "description": "Runs JavaScript and TypeScript from compiled Forst programs (RPC bootstrap, host mode, and compile-time type indexing)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forst-runtime-index": "dist/indexer/cli.js",
    "forst-runtime-bootstrap": "dist/bootstrap.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js",
      "default": "./dist/host.js"
    },
    "./host/register.cjs": "./dist/host/register.cjs",
    "./host/register.mjs": "./dist/host/register.mjs",
    "./opentelemetry": {
      "types": "./dist/effect/opentelemetry.d.ts",
      "import": "./dist/effect/opentelemetry.js",
      "default": "./dist/effect/opentelemetry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/host && cp src/host/register.cjs dist/host/register.cjs && cp src/host/register.mjs dist/host/register.mjs && cp src/host/register.d.ts dist/host/register.d.ts",
    "prepublishOnly": "bun run sync-jsr-version && bun run build",
    "sync-jsr-version": "node ./scripts/sync-jsr-version.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "build:clean": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/preload.ts",
    "pack:dry": "npm pack --dry-run --ignore-scripts"
  },
  "keywords": [
    "forst",
    "node",
    "typescript",
    "interop",
    "indexer"
  ],
  "author": "haveyaseen",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "^0.106.0",
    "effect": "^3.17.0",
    "ts-morph": "^27.0.2"
  },
  "peerDependencies": {
    "@effect/opentelemetry": ">=0.56.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/opentelemetry": "^0.56.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.4",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forst-lang/forst.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/forst-lang/forst/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/forst-lang/forst/issues"
  }
}
